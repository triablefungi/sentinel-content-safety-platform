# Non-secret production configuration example. Supply credentials through a secret manager.
SENTINEL_ENVIRONMENT=production
SENTINEL_DOCS_ENABLED=false
SENTINEL_HSTS_ENABLED=true
SENTINEL_MAX_REQUEST_BYTES=8388608
SENTINEL_RATE_LIMIT_ENABLED=true
SENTINEL_RATE_LIMIT_REQUESTS=120
SENTINEL_RATE_LIMIT_WINDOW_SECONDS=60
SENTINEL_RATE_LIMIT_MAX_CLIENTS=10000
SENTINEL_REVIEW_ENABLED=true
SENTINEL_REVIEW_AUTH_PATH=/run/secrets/reviewer-auth.json
SENTINEL_REVIEW_LEDGER_PATH=/var/lib/sentinel/review-ledger.jsonl

# Replace these local endpoints with authenticated, encrypted managed services.
SENTINEL_KAFKA_BOOTSTRAP_SERVERS=kafka.internal.example:9093
SENTINEL_REDIS_URL=rediss://redis.internal.example:6379/0
SENTINEL_QDRANT_URL=https://qdrant.internal.example
